{"", "onCollideWithPlayer", ApiKind::Callback, "function onCollideWithPlayer(self)", "Called when the player's collision capsule overlaps this object. Fires every frame while overlapping. Use a flag for one-time actions."},
{"", "onCreate", ApiKind::Callback, "function onCreate(self)", "Called once after the scene finishes loading and all objects are registered. Use for initialization. Entity.Find() works here for any object."},
{"", "onDisable", ApiKind::Callback, "function onDisable(self)", "Called when Entity.SetActive(self, false) deactivates the object."},
{"", "onEnable", ApiKind::Callback, "function onEnable(self)", "Called when Entity.SetActive(self, true) activates the object."},
{"", "onInteract", ApiKind::Callback, "function onInteract(self)", "Called when the player presses the interact button while near this object. Needs an Interactable component on the same object."},
{"", "onPathBlocked", ApiKind::Callback, "function onPathBlocked(self)", "Registered, but the engine never calls it yet."},
{"", "onPatrolPoint", ApiKind::Callback, "function onPatrolPoint(self, index)", "Called at each patrol waypoint, index counting from 0."},
{"", "onSceneCreationEnd", ApiKind::Callback, "function onSceneCreationEnd()", "Called AFTER all objects are created and their onCreate() has fired. Good for: UI setup, starting ambient effects, initial game state."},
{"", "onSceneCreationStart", ApiKind::Callback, "function onSceneCreationStart()", "Called early in scene initialization, BEFORE objects are created. Good for: loading persistent data, initializing variables."},
{"", "onStateEnter", ApiKind::Callback, "function onStateEnter(self, newState, oldState)", "Called after the agent's state changes (Agent.SetState, or Idle -> Patrol on its own)."},
{"", "onStateExit", ApiKind::Callback, "function onStateExit(self, state)", "Called just before it leaves state."},
{"", "onTargetLost", ApiKind::Callback, "function onTargetLost(self, target)", "Called once the alert timeout runs out after it last saw or heard the target."},
{"", "onTargetReached", ApiKind::Callback, "function onTargetReached(self)", "Called when it arrives at a position in the Seek, Wander or Investigate state (not while following an actor)."},
{"", "onTargetSeen", ApiKind::Callback, "function onTargetSeen(self, target)", "Called when it starts seeing its target (the player unless Agent.SetTarget set another). target is nil for the player."},
{"", "onTriggerEnter", ApiKind::Callback, "function onTriggerEnter(index)", "Called when the player enters the trigger volume. index is the trigger box's number, from 0. Goes in the script set on a Trigger component."},
{"", "onTriggerExit", ApiKind::Callback, "function onTriggerExit(index)", "Called when the player leaves the trigger volume. index is the trigger box's number, from 0. Goes in the script set on a Trigger component."},
{"", "onUpdate", ApiKind::Callback, "function onUpdate(self, dt)", "Called every frame. dt is a 4.12 fixed-point delta time value. 4096 = one 30fps frame (normal speed). Higher values mean the previous frame took longer (lag compensation). Capped at 4096*4. Use sparingly. Every object with onUpdate runs this every frame. Prefer event-driven patterns instead."},
