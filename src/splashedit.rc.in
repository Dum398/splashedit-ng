#include <winver.h>

// SDL and Explorer both take the first icon.
1 ICON "@SPLASHEDIT_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "psxsplash"
            VALUE "FileDescription", "SplashEdit"
            VALUE "FileVersion", "@SPLASHEDIT_VERSION@"
            VALUE "InternalName", "splashedit"
            VALUE "OriginalFilename", "splashedit.exe"
            VALUE "ProductName", "SplashEdit"
            VALUE "ProductVersion", "@SPLASHEDIT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
